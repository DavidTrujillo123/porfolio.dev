---
import Badge from "@/components/Badge.astro";
import MailIcon from "@/components/icons/Mail.astro";
import SocialPill from "@/components/SocialPill.astro";
import type { HeroProps } from "@/components/componetCosmic/utils/CosmicTypes";
import { socialIcons } from "@/components/componetCosmic/utils/IconsCosmic";

interface Props {
  hero: HeroProps;
}

const { hero } = Astro.props;
const { image_hero, linkedin_url, linkedin_text, social_pill, info, title } =
  hero;
---

<div class="max-w-xl">
  <div class="flex gap-4 mb-4">
    <img
      class="opacity-0 shadow-lg size-16 gsap-img"
      src={image_hero.imgix_url}
      alt={image_hero.alt_text}
    />
    <a
      href={linkedin_url}
      target="_blank"
      rel="noopener"
      class="flex items-center transition md:justify-center md:hover:scale-105 opacity-0 w-full gsap-badge"
    >
      <Badge>{linkedin_text}</Badge>
    </a>
  </div>
  <div class="relative">
    <h1
      class="text-4xl font-bold tracking-tight text-gray-800 sm:text-5xl dark:text-white gsap-title"
    >
      {title}
    </h1>
  </div>
  <div
    class="gsap-text-info mt-5 text-xl text-gray-800 dark:[&>strong]:text-yellow-200 [&>strong]:text-yellow-500 [&>strong]:font-semibold dark:text-gray-300"
    set:html={info}
  />
  <nav class="flex flex-wrap gap-4 mt-8 gsap-btns-social">
    {
      social_pill.map((social) => {
        const IconComponent = socialIcons[social.icon.value] || MailIcon;
        return (
          <SocialPill href={social.url} >
            <IconComponent class="size-4" />
            {social.text}
          </SocialPill>
        );
      })
    }
  </nav>
</div>
<script>
  import { gsap } from "gsap";
  import { SplitText } from "gsap/SplitText";
  
  //If use astro:page-load, the animation does not work with SSR
  //document.addEventListener("astro:page-load", (event) => {
  document.addEventListener("DOMContentLoaded", (event) => {

    gsap.registerPlugin(SplitText);

    const titleText = SplitText.create(".gsap-title", {
      type: "words",
      mask: "words",
      wordsClass: "mb-1",
    });

    const linesInfoText = SplitText.create(".gsap-text-info", {
      type: "lines",
      mask: "lines",
    })

    //Animacion imagen y badge
    const tl = gsap.timeline({
      defaults: {
        opacity: 1,
        duration: 1,
        ease: "power2.out",
      },
    });

    //const btns = document.querySelectorAll('.gsap-btns-social>a');

    tl
    .to(".gsap-img", {
      borderRadius: "50%",
    }, '<')
    .to(".gsap-badge", {
      width: "auto",
    }, '<')
    .from(titleText.words, {  
      y: 100,
      autoAlpha: 0,
      stagger: 0.2,
    }, '<')
    .from(linesInfoText.lines, {  
      y: 100,
      autoAlpha: 0,
      stagger: 0.3,
    }, '<')
    .fromTo('.gsap-btns-social > a', 
      {
        opacity: 0,
        //x: 100
      },
      {
        opacity: 1,
        //x: 0,
        stagger: 0.2,
      }, '<0.5'
    );    
  });
</script>
