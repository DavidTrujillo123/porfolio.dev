---
import ExperienceItem from "@/components/ExperienceItem.astro";
import type { ExperienceItemProps } from "@/components/componetCosmic/utils/CosmicTypes";

interface Props {
  experiences: ExperienceItemProps[];
}

const { experiences } = Astro.props;
---

<ol
  class="relative mt-16 gsap-experience-list overflow-hidden"
>
  {
    experiences.map((experience) => (
      <li class="">
        <ExperienceItem {...experience} />
      </li>
    ))
  }
</ol>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  document.addEventListener("DOMContentLoaded", (event) => {
    gsap.registerPlugin(ScrollTrigger);

    const tlExperience = gsap.timeline({
      defaults: {
        ease: "power2.inOut",
        stagger: 0.3,
      },
      scrollTrigger: {
        trigger: ".gsap-experience-list",
        start: "top bottom",
        end: "center center",
        toggleActions: "play none none reverse",
        scrub: 0.5,
      },
    });

    tlExperience
      .from(".gsap-experience-list > li", {
        xPercent: 100,
        autoAlpha: 0,
      })
      .from(
        ".gsap-experience-item-circle",
        {
          //Clase del circulo
          y: 50,
        },
        "<0.5"
      );
  });
</script>
