<div
  class:list={["flex items-center justify-center overflow-hidden md:overflow-visible cursor-pointer w-[100px] h-[100px]", Astro.props.class]}
>
  <div class="gsap-container-sprite h-full w-full">
    <div
      id="sprite"
      class="h-full w-full bg-cover bg-no-repeat scale-[300%] drop-shadow-lg drop-shadow-amber-900 dark:drop-shadow-indigo-500/50 "
      style="background-image: url('/sprites/Soldier_Idle.png'); background-position: 0 0;"
    >
    </div>
  </div>
</div>

<script>
  import { gsap } from "gsap";

  document.addEventListener("DOMContentLoaded", () => {
    const sprite = document.getElementById("sprite");
    if (!sprite) return;

    const frameWidth = 100;

    let currentAnimation: any = null;
    let state = "idle"; // idle, walk, attack

    const animations = {
      idle: {
        frames: 6,
        image: "/sprites/Soldier_Idle.png",
        fps: 6,
      },
      walk: {
        frames: 8,
        image: "/sprites/Soldier_Walk.png",
        fps: 6,
      },
      attack: {
        frames: 8,
        image: "/sprites/Soldier_Attack03.png",
        fps: 8,
      },
    };

    function playAnimation(animName: keyof typeof animations) {
      if (currentAnimation) {
        currentAnimation.kill();
      }

      const anim = animations[animName];

      if (!sprite) return;

      sprite.style.backgroundImage = `url('${anim.image}')`;
      gsap.set(sprite, { backgroundPosition: "0 0" });

      currentAnimation = gsap.to(sprite, {
        backgroundPosition: `-${frameWidth * (anim.frames - 1)}px 0px`,
        ease: "steps(" + (anim.frames - 1) + ")",
        duration: anim.frames / anim.fps,
        repeat: -1, // Todas se repiten infinitamente
      });
    }

    function setState(newState: keyof typeof animations) {
      state = newState;
      playAnimation(newState);
    }

    // Click para cambiar estado: idle -> walk -> attack -> idle
    sprite.addEventListener("click", () => {
      if (state === "idle") {
        setState("walk");
      } else if (state === "walk") {
        setState("attack");
      } else if (state === "attack") {
        setState("idle");
      }
    });

    // Iniciar con idle
    playAnimation("idle");
  });
</script>
